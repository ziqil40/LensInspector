# Copy to .env (gitignored) or export these before running.

# Session signing key. Without it everyone is signed out on every restart, and
# on a shared deployment it MUST be set. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# Comma-separated usernames allowed on the results pages. If left empty, the
# first person to sign in becomes the admin.
ADMIN_NETIDS=yourusername

# Optional overrides
# INSPECTOR_DB=data/inspector.db
# CUTOUT_DIR=./cutouts
# PORT=8000
# HOST=0.0.0.0
